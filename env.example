# ===========================================
# CONFIGURACIÓN DEL SISTEMA
# ===========================================
# Copia este archivo como .env y ajusta los valores

# App
APP_NAME=RiesgoAI Agent
APP_VERSION=0.1.0
DEBUG=True

# Database
# Para desarrollo local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/riesgo_db
# Para Supabase (producción):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# Groq API (opcional, como respaldo)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# RAG Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vector_store
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# External APIs
IDEAM_API_URL=http://www.ideam.gov.co
SGC_API_URL=https://www.sgc.gov.co
UNGRD_API_URL=https://portal.gestiondelriesgo.gov.co

# Security
SECRET_KEY=tu-clave-secreta-super-segura-cambiala-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (agregar tu frontend URL)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Background Tasks
FETCH_WEATHER_INTERVAL=300
FETCH_ALERTS_INTERVAL=60
